{
  "name": "hermandesejahtera/dsfiber-ppob-logistik",
  "description": "DSFiber - PPOB & Logistics Platform (Mobile-First)",
  "type": "project",
  "license": "proprietary",
  "authors": [
    {
      "name": "Herman De Sejahtera",
      "email": "herman@dsfiber.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "firebase/php-jwt": "^6.4",
    "ext-bcmath": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "DSFiber\\": "app/",
      "Database\\": "database/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "migrate": "php public/install.php",
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 app/ database/"
  }
}