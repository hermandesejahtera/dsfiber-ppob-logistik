# APP CONFIG
APP_NAME=DSFiber PPOB
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=your-secret-key-here

# DATABASE
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dsfiber_ppob
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE=86400

# SECURITY
PIN_SALT=your-pin-salt-here
ENCRYPTION_KEY=your-encryption-key-here
ENCRYPTION_CIPHER=AES-256-CBC

# PPOB - RAJABILLER
RAJABILLER_API_KEY=your-rajabiller-api-key
RAJABILLER_USERNAME=your-rajabiller-username
RAJABILLER_URL=https://api.rajabiller.com
RAJABILLER_WEBHOOK_SECRET=your-webhook-secret

# LOGISTICS - BITESHIP
BITESHIP_API_KEY=your-biteship-api-key
BITESHIP_URL=https://api.biteship.com
BITESHIP_WEBHOOK_SECRET=your-webhook-secret

# CACHE
CACHE_DRIVER=file
CACHE_TTL=3600

# LOG
LOG_LEVEL=info